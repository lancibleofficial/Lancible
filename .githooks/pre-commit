#!/bin/sh
# Быстрые проверки перед каждым коммитом. Секунды, а не минуты: браузерные
# тесты, снимки с эталоном и обращения к базе сюда не входят — их гоняет
# GitHub на каждый push, а между правками за ними следит `npm run watch`.
#
# Крюк включается сам на `npm install` (scripts/setup-hooks.js).
# Разово обойти: git commit --no-verify

# Чек-лист ревью — первым, он мгновенный: если коммит задел несколько
# областей или чувствительную (правовые тексты, выкат, регламент), крюк
# напоминает, что в них проверить. Коммит не останавливает (таблица —
# scripts/zones.js, регламент — CLAUDE.md → «Области и чек-лист ревью»).
node scripts/zones.js

# Граф кода обновляется до тестов: по нему работает проверка на мёртвый код,
# и по устаревшему графу она сказала бы неправду. Это AST, без обращений к
# сети и без оплаты — шесть секунд.
#
# Если graphify не установлен (свежий клон, чужая машина), коммит из-за этого
# не останавливаем: тест на мёртвый код сам пропустится с объяснением.
if command -v graphify >/dev/null 2>&1; then
  graphify update . >/dev/null 2>&1 || echo "graphify: граф обновить не вышло, проверка мёртвого кода пропустится"
else
  echo "graphify не найден — граф не обновлён (установка: uv tool install graphifyy)"
fi

npm run test:fast --silent
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Коммит остановлен: тесты не прошли."
  echo "Починить и повторить, либо обойти разово: git commit --no-verify"
  exit 1
fi

exit 0
