# Зависимости
node_modules/

# Сборка
dist/
build/icon.ico
build/icon.png

# Шрифт (пользователь кладёт свой Basique Pro отдельно — исходники не наши)
font/

# Скопированные на postinstall вендорные файлы (Quill, шрифты) — генерируются заново
src/renderer/vendor/

# Скриншоты и результаты локальных проверок — не часть исходников
scripts/preview-*.png
scripts/smoke-result.json
scripts/_check.xlsx
scripts/_smoke-export-*.xlsx

# Данные пользователя (на случай локального запуска рядом с исходниками)
data.json

# Секреты для scripts/publish-release.js (service_role-ключ Supabase) — никогда не коммитить
.env

# Отчёты и следы браузерных тестов — не исходники
playwright-report/
test-results/
# Сторож (npm run watch) пишет сюда, а не в test-results/: Playwright
# вычищает свою выходную папку в начале прогона, и ручной npm test сносил бы
# следы сторожа прямо посреди его работы.
test-results-watch/

# ОС/редакторы
.DS_Store
Thumbs.db
*.log
.vercel
.env*

# Граф кода graphify — производный артефакт, пересобирается `graphify update .`
# (3,9 МБ на коммит, из них 2 МБ graph.json)
graphify-out/

# Личные настройки Claude Code для этого проекта. Здесь же подключён
# oh-my-claudecode на пробу — только на этой машине, в репозиторий не уходит.
.claude/settings.local.json
# Рабочая папка oh-my-claudecode: журналы сессий, его навыки, артефакты.
.omc/
