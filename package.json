{
  "name": "lancible",
  "productName": "Lancible",
  "version": "0.1.0",
  "description": "Lancible — задачи, учёт времени и заработка",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "check:xlsx": "node scripts/xlsx-check.js",
    "icon": "electron scripts/make-icon.js",
    "package": "electron-builder --win nsis",
    "build:exe": "npm run icon && npm run package",
    "publish:release": "node scripts/publish-release.js",
    "postinstall": "node scripts/copy-vendor.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "quill": "^2.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.lancible.app",
    "productName": "Lancible",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/vendor/**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "http://localhost:8934/"
    }
  }
}
