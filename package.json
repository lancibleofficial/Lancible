{
  "name": "lancible",
  "productName": "Lancible",
  "version": "0.2.2",
  "description": "Lancible — задачи, учёт времени и заработка",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "check:xlsx": "node scripts/xlsx-check.js",
    "build:web": "node scripts/sync-web-assets.js",
    "serve:web": "npm run build:web && node scripts/serve-web.js",
    "icon": "electron scripts/make-icon.js",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg zip --universal",
    "build:exe": "npm run icon && npm run package:win",
    "build:dmg": "npm run icon && npm run package:mac",
    "publish:release": "node scripts/publish-release.js",
    "postinstall": "node scripts/copy-vendor.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "quill": "^2.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.lancible.app",
    "productName": "Lancible",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/vendor/**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "protocols": [
      {
        "name": "Lancible",
        "schemes": ["lancible"]
      }
    ],
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://yiglgfkjjvwijukdzutw.supabase.co/storage/v1/object/public/releases/"
    }
  }
}
