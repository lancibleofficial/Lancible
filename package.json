{
  "name": "lancible",
  "productName": "Lancible",
  "version": "0.4.0",
  "description": "Lancible — задачи, учёт времени и заработка",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "watch": "node scripts/watch.js",
    "test": "npm run test:unit && npm run check:xlsx && npm run test:mobile && npm run check:mobile-build && npm run test:backend && npm run test:e2e && npm run test:landing && npm run test:visual",
    "test:fast": "npm run test:unit && npm run check:xlsx",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:mobile": "npm --prefix mobile test",
    "test:backend": "node --test \"tests/backend/*.test.js\"",
    "test:e2e": "playwright test --project=web",
    "test:landing": "playwright test --project=landing",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "node scripts/visual-update.js",
    "check:xlsx": "node scripts/xlsx-check.js",
    "check:mobile-build": "node scripts/check-mobile-build.js",
    "graph:update": "graphify update .",
    "build:web": "node scripts/sync-web-assets.js",
    "serve:web": "npm run build:web && node scripts/serve-web.js",
    "serve:landing": "node scripts/serve-web.js 5174 --root landing",
    "icon": "electron scripts/make-icon.js",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg zip --universal",
    "build:exe": "npm run icon && npm run package:win",
    "build:dmg": "npm run icon && npm run package:mac",
    "publish:release": "node scripts/publish-release.js",
    "postinstall": "node scripts/copy-vendor.js",
    "prepare": "node scripts/setup-hooks.js",
    "graph:baseline": "node scripts/graph-baseline.js",
    "graph:orphans": "node scripts/graph-orphans.js",
    "site:refresh": "node scripts/publish-site.js",
    "site:app": "node scripts/build-landing-app.js",
    "build:editor": "node scripts/build-editor.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide": "^1.52.0",
    "markdown-it": "^14.3.2",
    "perfect-freehand": "^1.2.3",
    "png-to-ico": "^3.0.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.lancible.app",
    "productName": "Lancible",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/vendor/**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "protocols": [
      {
        "name": "Lancible",
        "schemes": [
          "lancible"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://yiglgfkjjvwijukdzutw.supabase.co/storage/v1/object/public/releases/"
    }
  }
}
