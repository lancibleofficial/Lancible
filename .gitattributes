# Перевод строки для файлов, которые сравниваются побайтно.
#
# Зачем это понадобилось. У репозитория core.autocrlf=true: при выгрузке git
# меняет LF на CRLF. Файлы ядра лежат в двух местах — src/renderer/core/ и
# скопированные в mobile/src/core/ — и tests/unit/mobile-core.test.js
# сравнивает их побайтно. Пока обе копии выгружаются одинаково, всё хорошо;
# но стоит одной из них пройти через git checkout, а другой остаться как
# была, и тест падает на различии, которого не видно глазами: диск держит
# CRLF, а соседний файл LF.
#
# Ровно это и случилось: после `git checkout src/renderer/core/tags.js` тест
# «копии совпадают с оригиналом побайтно» покраснел, а `git diff` при этом
# показывал пустоту.
#
# eol=lf прибивает перевод строки для этих файлов на всех машинах — и для
# Windows тоже. Остального репозитория правило не касается.
src/renderer/core/*.js text eol=lf
mobile/src/core/*.js   text eol=lf
