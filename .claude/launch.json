{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve:web"
      ],
      "port": 5173
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve:landing"
      ],
      "port": 5174
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "start",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
