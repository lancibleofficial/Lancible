{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/",
      "destination": "https://lancible-yrkx.vercel.app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "https://lancible-yrkx.vercel.app/:path*"
    }
  ]
}
