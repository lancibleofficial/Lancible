{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/logs",
      "destination": "/logs.html"
    },
    {
      "source": "/app/",
      "destination": "https://lancible-yrkx.vercel.app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "https://lancible-yrkx.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/logs",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/logs.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
